<Page
    x:Class="RavKavKiosk.Next.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="יומן פעילות" FontSize="30" FontWeight="SemiBold" />
        <Button Grid.Row="1" Content="רענן" Click="Refresh_Click" HorizontalAlignment="Right" />
        <ListView x:Name="EntriesList" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8" Spacing="3">
                        <TextBlock Text="{Binding Timestamp}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Category}" Opacity="0.7" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
