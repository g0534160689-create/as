<Page
    x:Class="RavKavKiosk.Next.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="14">
            <TextBlock Text="ניהול והרשאות" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="דומיין אחד בכל שורה. השינויים נשמרים במחשב המקומי." Opacity="0.75" />
            <ToggleSwitch x:Name="AllowPopupsSwitch" Header="אפשר חלונות קופצים" />
            <ToggleSwitch x:Name="UseAllowListSwitch" Header="חסום אתרים שאינם ברשימת ההרשאה" />
            <TextBlock Text="רשימת הרשאה" FontWeight="SemiBold" />
            <TextBox x:Name="AllowListBox" AcceptsReturn="True" MinHeight="110" PlaceholderText="example.com" />
            <TextBlock Text="רשימת חסימה" FontWeight="SemiBold" />
            <TextBox x:Name="BlockListBox" AcceptsReturn="True" MinHeight="110" PlaceholderText="blocked.example" />
            <Button Content="שמור הגדרות" Click="Save_Click" HorizontalAlignment="Right" />
            <InfoBar x:Name="StatusBar" IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
