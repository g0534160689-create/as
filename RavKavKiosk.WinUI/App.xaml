<Application
    x:Class="RavKavKiosk.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220"/>
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#111C2E"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#36B7A5"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AAAC0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA"/>
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#087F75"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#617187"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
