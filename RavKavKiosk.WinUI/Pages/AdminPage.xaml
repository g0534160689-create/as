<Page
    x:Class="RavKavKiosk.WinUI.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <ScrollViewer>
        <StackPanel Padding="34" Spacing="22">
            <StackPanel Spacing="5">
                <TextBlock Text="ניהול מערכת" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="מרכז בקרה למדיניות, אבטחה והתנהגות האתרים" Foreground="{ThemeResource MutedTextBrush}"/>
            </StackPanel>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="הרשאות וחלונות" FontSize="20" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="AllowPopupsSwitch" Header="אפשר חלונות קופצים מאתרים מורשים"/>
                    <ToggleSwitch x:Name="AllowExternalLinksSwitch" Header="אפשר קישורים חיצוניים מאושרים"/>
                    <ToggleSwitch x:Name="KeepActivitySwitch" Header="תעד פעולות ושינויים ביומן"/>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="רשימה שחורה" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="דומיין אחד בכל שורה. לדוגמה: example.com" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="BlacklistText" AcceptsReturn="True" MinHeight="170" TextWrapping="Wrap" PlaceholderText="example.com&#10;ads.example.org"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="רשימה לבנה" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="אתרים שמורשים במפורש. דומיין אחד בכל שורה." Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="WhitelistText" AcceptsReturn="True" MinHeight="170" TextWrapping="Wrap" PlaceholderText="ravkavonline.co.il"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="שמור את כל ההגדרות" Click="Save_Click"/>
                <Button Content="טען מחדש מהדיסק" Click="Reload_Click" Style="{StaticResource DefaultButtonStyle}"/>
            </StackPanel>
            <InfoBar x:Name="SaveStatus" IsOpen="False" Severity="Success" Title="ההגדרות נשמרו במחשב"/>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="הערה חשובה" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="הרשימות נשמרות כעת בקובץ settings.json במחשב. אכיפת החסימה וההרשאה בתוך WebView2 תחובר בשלב נפרד; שמירת הרשימה לבדה עדיין אינה חוסמת אתרים בפועל." TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
