<Page
    x:Class="RavKavKiosk.WinUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">
    <ScrollViewer>
        <StackPanel Padding="34" Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="ברוכים הבאים" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="מרכז השליטה של עמדת הרב־קו" FontSize="15" Foreground="{ThemeResource MutedTextBrush}"/>
            </StackPanel>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE8D7;" FontSize="24" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="עמדת רב־קו" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="פתיחת ממשק הטענה" Foreground="{ThemeResource MutedTextBrush}"/>
                        <Button Content="כניסה לעמדה" HorizontalAlignment="Stretch" Click="OpenRavKav_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="ניהול מערכת" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="שליטה בכללי האתרים והחלונות" Foreground="{ThemeResource MutedTextBrush}"/>
                        <Button Content="פתיחת הניהול" HorizontalAlignment="Stretch" Click="OpenAdmin_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="יומן פעילות" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="מעקב אחר פעולות ושינויים" Foreground="{ThemeResource MutedTextBrush}"/>
                        <Button Content="צפייה ביומן" HorizontalAlignment="Stretch" Click="OpenActivity_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="14" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="תשתית המערכת" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="היישום נבנה מחדש ב־WinUI 3 וב־XAML. בשלב הבא יחוברו רכיבי רב־קו, ניהול הרשאות, שמירת מדיניות מקומית, חלונות קופצים ויומן שינויים." TextWrapping="Wrap" Foreground="{ThemeResource MutedTextBrush}"/>
                    <InfoBar IsOpen="True" Severity="Informational" Title="גרסת בסיס" Message="זהו שלד ראשוני של הממשק. חיבור פעולות ההטענה והקורא יבוצע לאחר בדיקת הבנייה."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
