<Page
    x:Class="RavKavKiosk.WinUI.Pages.RavKavPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    FlowDirection="RightToLeft">
    <Grid Padding="18" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="עמדת רב־קו" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BrowserStatus" Text="מתחבר לסביבת הגלישה המאובטחת..." Foreground="{ThemeResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="חזרה" Click="Back_Click"/>
                    <Button Content="רענן" Click="Refresh_Click"/>
                    <Button Content="התחל בחירת אלמנט" Click="Inspect_Click"/>
                </StackPanel>
            </Grid>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="10" Padding="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedElementText" Text="לא נבחר אלמנט" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="הסתר ושמור" Click="HideSelected_Click"/>
                    <Button Grid.Column="2" Content="הצג את כל המוסתרים" Click="ShowAll_Click"/>
                </Grid>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="12" Padding="4">
            <controls:WebView2 x:Name="Browser" DefaultBackgroundColor="#FFFFFF" />
        </Border>
    </Grid>
</Page>
